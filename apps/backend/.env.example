# apps/backend
DATABASE_URL=postgres://user:pass@host:5432/serious_shift?sslmode=require
PORT=8080
# CORS allowlist (comma-separated origins). Unset = any origin (dev only).
FRONTEND_ORIGIN=https://your-frontend.up.railway.app
# Absolute origin for canonical URLs and the sitemap. Defaults to the first
# FRONTEND_ORIGIN entry, which is the same host for this deploy.
PUBLIC_ORIGIN=https://your-frontend.up.railway.app
# Bearer token gating the operator-only reads: /api/thinkers, /api/sources,
# /api/claims, /api/predictions, /api/stats and the deprecated full /api/map.
# Unset = those routes 404, which is the correct posture for a public deploy.
INSPECTION_TOKEN=
