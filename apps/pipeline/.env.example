# apps/pipeline
DATABASE_URL=postgres://user:pass@host:5432/serious_shift?sslmode=require
ANTHROPIC_API_KEY=sk-ant-...
# optional overrides (default to ./raw_content and ./logs under the working dir):
# RAW_CONTENT_DIR=./raw_content
# SS_LOGS_DIR=./logs
# POST the published shift list here after every successful publication.
# Unset = disabled. Contract: docs/SHIFT-MAP-WEBHOOK.md
# SS_SHIFTS_WEBHOOK_URL=https://receiver.example/shift-map

# ── Generated shift artwork (mapgen/art) ───────────────────────────────────
# Generated during synthesis and published in the same commit as the map, so
# the art and the taxonomy go live together. Unset GEMINI_API_KEY and the run
# publishes with whatever art already exists — never a failure.
# GEMINI_API_KEY=...
# SS_ART=0                    # kill switch: attach existing rows, generate none
# SS_ART_FORCE=1              # regenerate even where the prompt hash matches
# SS_ART_WORKERS=4            # concurrent generations
# SS_ART_BUDGET_USD=60        # runaway guard, not a budget
# SS_ART_DEADLINE_SECONDS=2400
# SS_ART_MODEL=gemini-3.1-flash-image
